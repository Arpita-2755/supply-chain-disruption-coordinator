# Copy to .env and fill in ONE provider. Leave everything empty to run in offline mode.
# Single switch: auto (default) = LLM if credentials exist, else offline | offline | llm
SCC_MODE=auto

# Option A: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Option B: any OpenAI-compatible endpoint (Ollama, LM Studio, Groq, ...): set key + base URL
# OPENAI_BASE_URL=http://localhost:11434/v1

# Option C: Azure OpenAI
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21
